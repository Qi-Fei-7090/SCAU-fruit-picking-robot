<?xml version="1.0"?>
<launch>
    <!--arm driver parameters-->
    <arg name="robot_ip" default="192.168.11.60" />
    <arg name="robot_model" default="minicobo" />

    <!--moveit parameters-->
    <arg name="show_rviz" default="true" />
    <arg name="load_robot_description" default="true" />
    <arg name="allow_trajectory_execution" default="true" />

    <!-- 0. Start driver -->
    <include file="$(find jaka_planner)/launch/moveit_server.launch">
        <arg name="ip" value="$(arg robot_ip)" />
        <arg name="model" value="$(arg robot_model)" />
    </include>

    <!-- 1. Open moveit -->
    <include file="$(eval find('mmc1'  + '_moveit_config') + '/launch/demo.launch')">
        <arg name="load_robot_description" value="$(arg load_robot_description)" />
        <arg name="allow_trajectory_execution" value="$(arg allow_trajectory_execution)" />
    </include>
</launch>