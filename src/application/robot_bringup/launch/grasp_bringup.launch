<?xml version="1.0"?>
<launch>
    <!--arm driver parameters-->
    <arg name="robot_ip" default="192.168.11.60" />
    <arg name="robot_model" default="minicobo" />

    <!--moveit
    parameters-->
    <arg name="show_rviz" default="true" />
    <arg name="load_robot_description" default="true" />
    <arg name="allow_trajectory_execution" default="true" />
    <!--camer
    parameters-->
    <arg name="add_realsense_d435i_mode" default="eye_on_hand" />
    <arg name="camera1_serial_no" default="420122070214" />
    <arg name="camera2_serial_no" default="420122070214" />
    <arg name="align_depth" default="true" />
    <arg name="camera" default="camera" />


    <include file="$(find robot_bringup)/launch/arm_bringup.launch">
        <arg name="robot_ip" value="$(arg  robot_ip)" />
        <arg name="robot_model" value="$(arg  robot_model)" />
        <arg name="show_rviz" value="$(arg  show_rviz)" />
        <arg name="load_robot_description" value="$(arg  load_robot_description)" />
        <arg name="allow_trajectory_execution" value="$(arg  allow_trajectory_execution)" />
    </include>
    <include file="$(find robot_bringup)/launch/camera.launch">
        <arg name="add_realsense_d435i_mode" value="$(arg  add_realsense_d435i_mode)" />
        <arg name="camera1_serial_no" value="$(arg  camera1_serial_no)" />
        <arg name="camera2_serial_no" value="$(arg  camera2_serial_no)" />
        <arg name="align_depth" value="$(arg  align_depth)" />
        <arg name="camera" value="$(arg  camera)" />
    </include>
      <node pkg="rviz" name="rviz" type="rviz" args="-d $(env HOME)/rpp_data/rviz/rpp_grasp.rviz" />


</launch>
